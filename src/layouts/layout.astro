---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Катасонов — кухня шефа' } = Astro.props;
---

<!doctype html>
<html lang="ru">
   <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- 1. Для старых браузеров и RSS (обязательно sizes="32x32" для фикса бага Chrome) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    
    <!-- 2. Для современных браузеров (поддерживает темную тему) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- 3. Для iOS (добавление на домашний экран) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- 4. Для Android / PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#243122" /> <!-- Цвет вкладки браузера -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
