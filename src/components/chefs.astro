---
import styles from './chefs.module.css';
import { containerStyles } from './container';
import { chefs } from '../data/chefs';
---

<section class={styles.section}>
  <div class={containerStyles}>
    <div class={styles.head}>
      <h2 class={styles.title}>Наши шефы</h2>
      <p class={styles.subtitle}>Выберите шефа и оформите заказ: торты, кейтеринг или свежая выпечка.</p>
    </div>

    <div class={styles.slider}>
      <ul class={styles.grid} data-chefs-grid>
        {chefs.map((chef) => (
          <li class={styles.item}>
            <a class={styles.card} href={`/chefs/${chef.slug}`}>
              <span class={styles['image-wrap']}>
                <img class={styles.image} src={chef.img} alt={chef.name} loading="lazy" decoding="async" />
              </span>
              <span class={styles.body}>
                <span class={styles.name}>{chef.name}</span>
                <span class={styles.role}>{chef.role}</span>
                <span class={styles.exp}>{chef.experience}</span>
                <span class={styles.desc}>{chef.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <button class:list={[styles.arrow, styles.prev]} data-chefs-prev type="button" aria-label="Предыдущие шефы">←</button>
      <button class:list={[styles.arrow, styles.next]} data-chefs-next type="button" aria-label="Следующие шефы">→</button>
    </div>
  </div>

  <script>
    const grid = document.querySelector('[data-chefs-grid]') as HTMLElement;
    const prev = document.querySelector('[data-chefs-prev]') as HTMLButtonElement;
    const next = document.querySelector('[data-chefs-next]') as HTMLButtonElement;

    // листаем на 80% видимой ширины ленты
    const step = () => grid.clientWidth * 0.8;

    prev.addEventListener('click', () => grid.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => grid.scrollBy({ left: step(), behavior: 'smooth' }));
  </script>
</section>
