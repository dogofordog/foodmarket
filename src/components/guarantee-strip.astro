---
import styles from './guarantee-strip.module.css';

interface Props {
  text?: string;
}

const {
  text = 'Гарантия вкуса — первая замена блюда всегда бесплатно',
} = Astro.props;
---

<div class={`container ${styles.strip}`}>
  <span class={styles.icon}>⭐</span>
  <p class={styles.text}>{text}</p>
</div>