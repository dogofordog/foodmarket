---
import styles from './guarantee-strip.module.css';
import { containerStyles } from './container';

interface Props {
  text?: string;
}

const { text = 'Гарантия вкуса — первая замена блюда всегда бесплатно!' } =
  Astro.props;
---

<button
  class:list={[containerStyles, styles.strip]}
  type="button"
  data-guarantee-open
>
  <span class={styles.icon} aria-hidden="true">⭐</span>
  <span class={styles.text}>{text}</span>
</button>
