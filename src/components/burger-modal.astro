---
import styles from './burger-modal.module.css';
import { contacts } from '@/data/footer';
---

<div class={styles.overlay} data-burger-overlay hidden>
  <div
    class={styles.dialog}
    role="dialog"
    aria-modal="true"
    aria-label="Меню сайта"
  >
    <button
      class={styles.close}
      type="button"
      data-burger-close
      aria-label="Закрыть меню"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <header class={styles.head}>
      <p class={styles.brandName}>Катасонов</p>
      <p class={styles.brandTag}>Personal chef brand</p>
    </header>

    <div class={styles.grid}>
      <div class:list={[styles.row, styles.row1]}>
        <section class:list={[styles.card, styles.tintBeige]}>
          <img
            class={styles.cardBg}
            src="/images/burger/menu.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Шеф-меню</h2>
          <div class={styles.pills}>
            <a class={styles.pill} href="/menu/zavtraki">Завтраки</a>
            <a class={styles.pill} href="/menu/salaty">Салаты</a>
            <a class={styles.pill} href="/menu/supy">Супы</a>
            <a class={styles.pill} href="/menu/goryachie-blyuda">Горячие</a>
            <a class={styles.pill} href="/menu/deserty">Десерты</a>
            <a class:list={[styles.pill, styles.pillAccent]} href="/menu"
              >Все меню</a
            >
          </div>
        </section>

        <section class:list={[styles.card, styles.tintTeal]}>
          <img
            class={styles.cardBg}
            src="/images/burger/promo.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Акции</h2>
          <p class={styles.cardText}>
            Скидка 5%, бесплатная доставка, подарки за отзыв
          </p>
        </section>

        <section class:list={[styles.card, styles.tintPink]}>
          <img
            class={styles.cardBg}
            src="/images/burger/delivery.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Доставка и оплата</h2>
          <p class={styles.cardText}>СПб, от 45 мин, бесплатно от 3 000 ₽</p>
        </section>
      </div>

      <div class:list={[styles.row, styles.row2]}>
        <section class:list={[styles.card, styles.tintMint]}>
          <img
            class={styles.cardBg}
            src="/images/burger/subscription.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>
            <a class={styles.cardLink} href="/subscription"
              >Подписка на питание</a>
          </h2>
          <p class={styles.cardText}>
            От 930 ₽/день, персональный план от шефа
          </p>
        </section>

        <section class:list={[styles.card, styles.tintBeige]}>
          <img
            class={styles.cardBg}
            src="/images/burger/blog.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Блог шефа</h2>
          <p class={styles.cardText}>Рецепты, истории и секреты кухни</p>
        </section>

        <section class:list={[styles.card, styles.tintTeal]}>
          <img
            class={styles.cardBg}
            src="/images/burger/reviews.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Отзывы</h2>
          <div class={styles.pills}>
            <a class={styles.pill} href="/#reviews">Все отзывы</a>
            <a class:list={[styles.pill, styles.pillSolid]} href="/#reviews"
              >Оставить отзыв</a
            >
          </div>
        </section>
      </div>

      <div class:list={[styles.row, styles.row3]}>
        <section class:list={[styles.card, styles.tintPink]}>
          <img
            class={styles.cardBg}
            src="/images/burger/office.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitlePlain}>
            <a class={styles.cardLink} href="/audience/office">ДЛЯ ОФИСА</a>
          </h2>
          <p class={styles.cardText}>Обеды в офис по подписке, от 390 ₽/день</p>
        </section>

        <section class:list={[styles.card, styles.tintMint]}>
          <img
            class={styles.cardBg}
            src="/images/burger/family.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitlePlain}>
            <a class={styles.cardLink} href="/audience/family">ЛЮБИМЫЕ БЛЮДА</a>
          </h2>
          <p class={styles.cardText}>
            Любимые блюда для всей семьи с доставкой
          </p>
        </section>

        <section class:list={[styles.card, styles.tintBeige]}>
          <img
            class={styles.cardBg}
            src="/images/burger/business.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitlePlain}>
            <a class={styles.cardLink} href="/audience/business">БИЗНЕС</a>
          </h2>
          <p class={styles.cardText}>
            Питание смены от 50 человек — от 320 ₽/порция
          </p>
        </section>
      </div>

      <div class:list={[styles.row, styles.row4]}>
        <section class:list={[styles.card, styles.tintTeal]}>
          <img
            class={styles.cardBg}
            src="/images/burger/home.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>
            <a class={styles.cardLink} href="/audience/private-chef"
              >Шеф на дом</a>
          </h2>
          <p class={styles.cardText}>Ужин с шефом у вас дома — от 8 900 ₽</p>
        </section>

        <section class:list={[styles.card, styles.tintPink]}>
          <img
            class={styles.cardBg}
            src="/images/burger/contacts.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Контакты</h2>
          <a class={styles.phone} href={contacts.phoneHref}>{contacts.phone}</a>
          <div class={styles.pills}>
            <a class={styles.pill} href="#">MAX</a>
            <a class={styles.pill} href="#">Telegram</a>
          </div>
        </section>

        <section class:list={[styles.card, styles.tintBlue, styles.cabinet]}>
          <img
            class={styles.cardBg}
            src="/images/burger/cabinet.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
          />
          <h2 class={styles.cardTitle}>Кабинет</h2>
          <p class={styles.cardText}>
            Войдите, чтобы отслеживать заказы и бонусы
          </p>
          <button class={styles.login} type="button">Войти</button>
        </section>
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.querySelector(
    '[data-burger-overlay]',
  ) as HTMLElement;
  const dialog = overlay.querySelector('[role="dialog"]') as HTMLElement;

  const open = () => {
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    (dialog.querySelector('[data-burger-close]') as HTMLElement)?.focus();
  };

  const close = () => {
    overlay.hidden = true;
    document.body.style.overflow = '';
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('[data-burger-open]')) {
      open();
      return;
    }

    if (target.closest('[data-burger-close]') || target === overlay) {
      close();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !overlay.hidden) close();
  });
</script>
