---
import styles from './subscription-teaser.module.css';
import { containerStyles } from './container';
---

<section class={styles.section}>
  <div class={containerStyles}>
    <a href="/subscription" class={styles.card}>
      <img class={styles.bg} src="/images/subscription/teaser.jpg" alt="" loading="lazy" decoding="async" />
      <div class={styles.content}>
        <div class={styles.head}>
          <h2 class={styles.title}>Подписка на питание</h2>
          <p class={styles.text}>Ежедневная доставка авторских блюд — свежих и готовых к подаче</p>
        </div>
        <p class={styles.price}>
          <span class={styles['price-now']}>от 930 ₽/день</span>
          <s class={styles['price-old']}>1 240 ₽</s>
        </p>
        <span class={styles.button}>Узнать про подписку</span>
      </div>
    </a>
  </div>
</section>
